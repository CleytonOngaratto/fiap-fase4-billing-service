{
  "info": {
    "name": "Billing Service",
    "description": "As rotas do Billing Service, com os mesmos nomes de variável do fluxo completo do os-service. Um orçamento só existe depois que a saga chega ao CreateBudget: preencha workOrderId e cpf com os da ordem de serviço, ou rode antes o fluxo completo. Rode uma pasta por vez, pelo Collection Runner ou pelo Newman: aprovar e rejeitar são caminhos alternativos do mesmo orçamento.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticação",
      "description": "Pelo API Gateway.",
      "item": [
        {
          "name": "Login do ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/carworkshop/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Token do cliente pelo CPF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('customerToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpf}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Lambda de autenticação: só existe pelo API Gateway."
          }
        }
      ]
    },
    {
      "name": "Consultas",
      "item": [
        {
          "name": "Informações do serviço",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/billing/v1/info",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Orçamento da OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.environment.get('attempts') || 0);",
                  "const ready = pm.response.code === 200;",
                  "if (!ready && attempts < 40) {",
                  "  pm.environment.set('attempts', attempts + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  setTimeout(() => {}, 3000);",
                  "  return;",
                  "}",
                  "pm.environment.unset('attempts');",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('budgetId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/billing/v1/budgets?work_order_id={{workOrderId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Orçamento por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/billing/v1/budgets/{{budgetId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Webhook sem assinatura é recusado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/v1/webhooks/mercadopago",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"payment\",\n  \"data\": {\n    \"id\": \"1\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Aprovação",
      "item": [
        {
          "name": "Aprovar o orçamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/billing/v1/budgets/{{budgetId}}/approve",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Link de pagamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.environment.get('attempts') || 0);",
                  "const ready = pm.response.code === 200 && !!pm.response.json().paymentLink;",
                  "if (!ready && attempts < 40) {",
                  "  pm.environment.set('attempts', attempts + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  setTimeout(() => {}, 3000);",
                  "  return;",
                  "}",
                  "pm.environment.unset('attempts');",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const budget = pm.response.json();",
                  "pm.environment.set('paymentLink', budget.paymentLink);",
                  "console.log(`Pague antes de ${budget.paymentDeadline}: ${budget.paymentLink}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/billing/v1/budgets?work_order_id={{workOrderId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "O pagamento é um passo humano, no link que esta requisição imprime."
          }
        }
      ]
    },
    {
      "name": "Rejeição",
      "item": [
        {
          "name": "Rejeitar o orçamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/billing/v1/budgets/{{budgetId}}/reject",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
